# Supabase (backend-only, service role — НІКОЛИ не потрапляє на frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Порт Express-сервера
PORT=3001

# Дозволені origin для CORS та Socket.IO (через кому).
# Якщо не задано — використовується localhost:3000 та localhost:5173.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# LiveKit Cloud — Settings -> API Keys у dashboard.livekit.io
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
